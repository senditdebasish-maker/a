{
  "name": "netaji-college/admission-hub",
  "description": "XAMPP-ready admissions, CMS and college data hub for Netaji College of Pharmacy",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "ext-mbstring": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "phpmailer/phpmailer": "^6.9",
    "dompdf/dompdf": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "app/Support/helpers.php"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {}
  }
}
